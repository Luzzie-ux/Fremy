{
  "name": "fremy",
  "version": "1.0.0",
  "description": "discord.js client wrapper",
  "keywords": [
    "discord",
    "discord.js",
    "wrapper"
  ],
  "repository": {
    "type": "github",
    "url": "https://github.com/Luzzie-ux/Fremy.git"
  },
  "license": "Apache-2.0",
  "author": "Luzzie-ux",
  "type": "module",
  "main": "Fremy.js",
  "scripts": {
    "build": "rm -rf ./dist && npx tsc",
    "start": "node index.js",
    "env": "node --env-file=.env index.js",
    "lint": "npx eslint && echo $?",
    "test": "npm run build && npm run lint && npm run start",
    "test-env": "npm run build && npm run lint && npm run env"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/typescript": "^0.4.29",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
